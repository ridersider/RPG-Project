using UnityEngine;
using UnityEngine.Events;

[CreateAssetMenu(fileName = "NewMeleeAbility", menuName = "Abilities/Melee")]
public class MeleeAbility : Ability
{
    public float damage = 15f;
    
    private GameObject activeCollider;
    
    public override void Activate(GameObject owner, Vector2 direction)
    {
        onAbilityStart?.Invoke();
        
        // Activate collider on owner
        if (colliderPrefab != null)
        {
            activeCollider = Instantiate(colliderPrefab, owner.transform);
            activeCollider.transform.localPosition = colliderOffset;
            
            // Rotate collider towards direction
            float angle = Mathf.Atan2(direction.y, direction.x) * Mathf.Rad2Deg;
            activeCollider.transform.rotation = Quaternion.Euler(0, 0, angle);
            
            // Set damage
            DamageCollider dmgCollider = activeCollider.GetComponent<DamageCollider>();
            if (dmgCollider != null)
            {
                dmgCollider.SetDamage(damage, owner);
                dmgCollider.SetDuration(colliderDuration);
            }
            
            // Auto-destroy
            Destroy(activeCollider, colliderDuration);
        }
    }
    
    public override void Deactivate()
    {
        if (activeCollider != null)
            Destroy(activeCollider);
    }
}
</file>

