using System.Collections.Generic;
using UnityEngine;

public class PlayerCombatController : MonoBehaviour
{
    [System.Serializable]
    public class AbilitySlot
    {
        public KeyCode activationKey;
        public Ability ability;
        public float currentCooldown;
        public bool isActive;
    }
    
    [SerializeField] private List<AbilitySlot> abilitySlots = new List<AbilitySlot>();
    [SerializeField] private EntityData entityData;
    
    private PlayerController2D playerController;
    private SpriteAnimator animator;
    private Ability currentAbility;
    
    private void Awake()
    {
        playerController = GetComponent<PlayerController2D>();
        animator = GetComponent<SpriteAnimator>();
        
        // Initialize from EntityData
        if (entityData != null && entityData.abilities != null)
        {
            for (int i = 0; i < entityData.abilities.Count && i < 4; i++)
            {
                abilitySlots.Add(new AbilitySlot
                {
                    activationKey = KeyCode.Alpha1 + i,
                    ability = entityData.abilities[i],
                    currentCooldown = 0
                });
            }
        }
    }
    
    private void Update()
    {
        // Update cooldowns
        for (int i = 0; i < abilitySlots.Count; i++)
        {
            if (abilitySlots[i].currentCooldown > 0)
            {
                abilitySlots[i].currentCooldown -= Time.deltaTime;
            }
        }
        
        // Check ability inputs
        for (int i = 0; i < abilitySlots.Count; i++)
        {
            if (Input.GetKeyDown(abilitySlots[i].activationKey))
            {
                TryActivateAbility(i);
            }
        }
        
        // Mouse activation for aimed abilities
        if (Input.GetMouseButtonDown(0)) // Left click
        {
            TryActivateAimedAbility(0);
        }
        
        if (Input.GetMouseButtonDown(1)) // Right click
        {
            TryActivateAimedAbility(1);
        }
    }
    
    private void TryActivateAbility(int slotIndex)
    {
        if (slotIndex >= abilitySlots.Count) return;
        
        AbilitySlot slot = abilitySlots[slotIndex];
        
        if (slot.currentCooldown > 0 || slot.isActive) return;
        if (!slot.ability.CanActivate(gameObject)) return;
        
        // Get aim direction
        Vector2 aimDirection = playerController.GetAimDirection();
        
        // Trigger animation if specified
        if (slot.ability.triggerAnimation != PlayerAnimState.Idle)
        {
            animator.Play(slot.ability.triggerAnimation);
        }
        
        // Activate ability
        slot.ability.Activate(gameObject, aimDirection);
        slot.currentCooldown = slot.ability.cooldown;
        slot.isActive = true;
        
        currentAbility = slot.ability;
        
        // Start cooldown timer
        StartCoroutine(ResetAbilitySlot(slotIndex, slot.ability.cooldown));
    }
    
    private void TryActivateAimedAbility(int slotIndex)
    {
        // Similar to above but with mouse aiming
        Vector2 mousePos = Camera.main.ScreenToWorldPoint(Input.mousePosition);
        Vector2 direction = (mousePos - (Vector2)transform.position).normalized;
        
        // Update facing direction
        playerController.SetAimDirection(direction);
        
        // Activate ability with precise direction
        // ... rest of activation logic
    }
    
    private System.Collections.IEnumerator ResetAbilitySlot(int index, float delay)
    {
        yield return new WaitForSeconds(delay);
        abilitySlots[index].isActive = false;
        
        if (currentAbility != null)
        {
            currentAbility.Deactivate();
            currentAbility = null;
        }
    }
    
    // Public method for animation events to trigger ability effects
    public void OnAnimationTrigger(string abilityName)
